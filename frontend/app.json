{
  "expo": {
    "name": "TalkVerse",
    "slug": "TalkVerse",
    "jsEngine": "hermes",
    "scheme": "TalkVerse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/talkVerse(2).png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/talkVerse(2).png",
      "resizeMode": "contain",
      "backgroundColor": "#387478"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
